+.loan-workflow {
+ .intake-mode-tabs { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 15px; margin: 24px 0; >button { display: flex; align-items: center; gap: 12px; padding: 18px; background: #fff; border: 1px solid #dfe7f2; border-radius: 12px; text-align: left; color: #385473; min-width: 0; box-shadow: 0 2px 6px #213d5f04; } strong, small { display: block; } strong { font-size: 14px; line-height: 1.5; } small { font-size: 11px; color: #7890aa; margin-top: 5px; line-height: 1.6; } .active { border-color: #6384d5; background: #f0f5ff; box-shadow: inset 0 -3px #5e7fce; .intake-mode-number { background: #355bd7; color: white; } } }
+ .intake-mode-number { display: grid; place-items: center; width: 34px; height: 34px; flex-shrink: 0; border-radius: 10px; background: #eaf0fa; color: #6c86ac; font-size: 11px; font-weight: 700; }
+ .intake-mode-arrow { margin-left: auto; color: #8aa1c6; } .customer-risk { margin-top: 7px; font-size: 9px; }
+ .connector-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin: 30px 0 23px; h2 { font-size: 25px; margin: 0 0 10px; letter-spacing: -.7px; } p { color: #657e99; font-size: 13px; line-height: 1.8; max-width: 660px; } }
